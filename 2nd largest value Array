import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        long a[]=new long[n];
        for(int i=0;i<n;i++){
            a[i]=s.nextLong();
        }
        long max=a[0];
        for(int i=0;i<n;i++){
            if(max<a[i]){
                max=a[i];
            }
        }
        long smax=a[0];
        for(int i=0;i<n;i++){
            if(a[i]>smax&&a[i]<max){
                smax=a[i];
            }
        }
        System.out.print(smax);
    }
}
