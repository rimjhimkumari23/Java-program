import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		while(t-->0){
		    int x=s.nextInt();
		    int y=s.nextInt();
		    if(x*3<=y*2){
		        System.out.println(x*3);
		    }
		    else{
		        System.out.println(y*2);
		    }
		}
	}
}
