import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		while(t-->0){
		    int n=s.nextInt();
		    int x=s.nextInt();
		    int a=n-x;
		    if(a<=0){
		        System.out.println(0);
		    }
		    else if(a%4==0){
		        System.out.println(a/4);
		    }
		    else{
		        System.out.println((a/4)+1);
		    }
		}
	}
}
