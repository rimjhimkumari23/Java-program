import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
		Scanner s=new Scanner(System.in);
		int a=s.nextInt();
		int b=s.nextInt();
		int x=s.nextInt();
		int y=s.nextInt();
		int c=(a*2)+b;
		int z=(x*2)+y;
		if(c==z){
		    System.out.println("Equal");
		}
    else if(c>z){
        System.out.println("Messi");
    }
    else{
        System.out.println("Ronaldo");
    }
	}
}
