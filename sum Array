import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        long n=s.nextLong();
        long sum=0;
        long arr[]=new long[(int)n];
        for(long i=0;i<n;i++){
            arr[(int)i]=s.nextLong();
        }
        for (long i = 0; i < n; i++) {
            sum=sum+arr[(int)i];
        }
            System.out.print(sum + " ");
        
       
    }
}
