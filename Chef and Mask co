import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		while(t-->0){
		    int x=s.nextInt();
		    int y=s.nextInt();
		    if(x*100>=y*10)
		    System.out.println("Cloth");
		    else
		    System.out.println("Disposable");
 		}
	}
}
