import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        long arr1[]=new long[n];
        long sum=0;
        for(int i=0;i<n;i++){
            arr1[i]=s.nextLong();
              sum=arr1[0]+arr1[n-1];
        }
        System.out.println(sum);
    }
}
