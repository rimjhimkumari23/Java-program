import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        long a[]=new long[n];
        for(int i=0;i<n;i++){
            a[i]=s.nextLong();
        } 
        for(int i=n/2,j=n-1;i<j;i++,j--){
            long t=a[i];
            a[i]=a[j];
            a[j]=t;
        }
        for(int i=0;i<n;i++){
            System.out.print(a[i]+" ");
        }
    }
}
