import java.util.Scanner;
class Solution{
    public int floor(int arr[],int n,int x){
        int ans=-1;
        int low=0,high=n-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(arr[mid]<=x){
                ans=mid;
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
        return arr[ans];
    }
    public int ceil(int arr[],int n,int x){
        int ans=n;
        int low=0,high=n-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(arr[mid]>=x){
                ans=mid;
                high=mid-1;
            }
            else{
                low=mid+1;
            }
        }
        return arr[ans];
    }
}

public class FloorCeil {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        int x = sc.nextInt();
        Solution sol = new Solution();
        System.out.println(sol.floor(arr, n, x));
        System.out.println(sol.ceil(arr, n, x));
    }
}
