import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
		 Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();
        while (T-- > 0) {
            int A = sc.nextInt();
            int B = sc.nextInt();
            int third = 21 - A - B;
            if (third >= 1 && third <= 10) {
                System.out.println(third);
            } else {
                System.out.println(-1);
            }
        }
	}
}
