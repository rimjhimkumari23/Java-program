import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        long arr[]=new long[n];
        for(int i=0;i<n;i++){
            arr[i]=s.nextLong();
        }
        long k=s.nextLong();
        for(int i=0;i<n;i++){
            if(arr[i]<k){
                System.out.print(arr[i]+" ");
            }
        }
    }
}
