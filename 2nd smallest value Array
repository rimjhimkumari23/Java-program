import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        long a[]=new long[n];
        for(int i=0;i<n;i++){
            a[i]=s.nextLong();
        }
        long min=a[n-1];
        for(int i=0;i<n;i++){
            if(min>a[i]){
                min=a[i];
            }
        }
        long smin=a[n-1];
        for(int i=0;i<n;i++){
            if(a[i]<smin&&a[i]>min){
                smin=a[i];
            }
        }
        System.out.print(smin);
    }
}
