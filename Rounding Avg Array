import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        long sum=0;
        long arr[]=new long[n];
        for(int i=0;i<n;i++){
            arr[i]=s.nextLong();
        }
        for (int i = 0; i < n; i++) {
            sum=sum+arr[i];
        }
            System.out.print(Math.round((double)sum/n));
    }
}
