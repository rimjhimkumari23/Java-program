import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
	    Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		while(t-->0){
		    int c=s.nextInt();
		    int x=s.nextInt();
		    int y=s.nextInt();
		    int a=c-x;
		    System.out.println(a*y);
		}
	}
}
