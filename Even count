import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        long n=s.nextLong();
        long c=0;
        while(n>0){
            long r=n%10;
            if(r%2==0){
                c++;
            }
            n=n/10;
        }
        System.out.println(c);
    }
}
