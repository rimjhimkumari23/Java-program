import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
        Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();
        while (T-- > 0) {
            int A = sc.nextInt();
            int B = sc.nextInt();
            int X = sc.nextInt();
            int Y = sc.nextInt();
            if (A * Y < B * X) {
                System.out.println("Chef");
            } 
            else if (A * Y > B * X) {
                System.out.println("Chefina");
            } 
            else {
                System.out.println("Both");
            }
        }
    }
}
