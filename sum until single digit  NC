import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        long n=s.nextLong();
         while(n>9){
        long sum=0;
        while(n>0){
            long r=n%10;
            sum=sum+r;
            n=n/10;
            }
            n=sum;
        }
        System.out.println(n);
    }
}
