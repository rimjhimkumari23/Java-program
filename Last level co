import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		while(t-->0){
		    int x=s.nextInt();
		    int y=s.nextInt();
		    int z=s.nextInt();
		    int l=x*y;
            int b=(x-1)/3;
            int br=b*z;
            int to=l+br;
            System.out.println(to);
		}
	}
}
