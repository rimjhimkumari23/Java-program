import java.util.Scanner;
public class Binary {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] nums = new int[n];
        for (int i = 0; i < n; i++) {
            nums[i] = sc.nextInt();
        }
        int target = sc.nextInt();
        int low=0,high=nums.length-1;
        int re=-1;
        while(low<=high){
            int mid=(low+high)/2;
            if(nums[mid]==target){
            re=mid;
            break;
            }
            else if(target>=nums[mid]){
                low=mid+1;
            }
            else{
                high=mid-1;
            }
        }
     System.out.println(re);
    }
}
