import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		while(t-->0){
		    int n=s.nextInt();
		    int m=s.nextInt();
		    int x=s.nextInt();
		    int a=2*n+2*m;
		    System.out.println(x*a);
		}
	}
}
