public class updowntriangle{
    static void rim(int n){
        for(int i=1;i<=n*2-1;i++){
            for(int j=1;j<=n-Math.abs(n-i);j++){
                System.out.print("*");
            }
            System.out.println("");
        }
    }
    public static void main(String[] args) {
        int a[] = {5, 6, 7, 4};
        for (int i = 0; i < 4; i++) {
            System.out.println("testcase: " + a[i]);
            rim(a[i]);
            System.out.println("");
}}}
