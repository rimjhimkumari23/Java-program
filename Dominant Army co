import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
		Scanner s=new Scanner(System.in);
		int t=s.nextInt();
		while(t-->0){
		    int na=s.nextInt();
		    int nb=s.nextInt();
		    int nc=s.nextInt();
		    if(na>nb+nc||nb>na+nc||nc>na+nb){
		        System.out.println("YES");
		    }
		    else{
		        System.out.println("NO");
		    }
		}
	}
}
