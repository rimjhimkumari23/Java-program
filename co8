import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
	  Scanner s=new Scanner(System.in);
	  int t=s.nextInt();
	  int max=0,min=0;
	  while(t-->0){
	      int a=s.nextInt();
	      int b=s.nextInt();
	      int c=s.nextInt();
	      if(a>b&&a>c){
	          max=a;
	      }
	      else if(b>c){
	          max=b;
	      }
	      else{
	          max=c;
	      }
	      if(a<b&&a<c){
	           min=a;
	      }
	      else if(b<c){
	          min=b;
	      }
	      else{
	          min=c;
	      }
	      if(a>min&&a<max){
	          System.out.println(a);
	      }
	      else if(b>min&&b<max){
	          System.out.println(b);
	      }
	      else{
	          System.out.println(c);
	      }
	  }
	}
}
