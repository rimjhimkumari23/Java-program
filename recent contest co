import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();
        while (T-- > 0) {
            int N = sc.nextInt();
            int start = 0;
            int ltime = 0;
            for (int i = 0; i < N; i++) {
                String code = sc.next();
                if (code.equals("START38")) {
                    start++;
                } else {
                    ltime++;
                }
            }
            System.out.println(start + " " + ltime);
        }
	}
}
