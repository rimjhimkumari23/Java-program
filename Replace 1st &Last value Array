import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        long arr1[]=new long[n];
        long m[]=new long[2];
        for(int i=0;i<n;i++){
            arr1[i]=s.nextLong();
        }
        for(int i=0;i<2;i++){
         m[i]=s.nextLong();
        }
         for(int i=0;i<n;i++){
         arr1[0]=m[0];
           arr1[n-1]=m[1];
            System.out.print(arr1[i]+" ");
        }
    }
}
