import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        long n=s.nextLong();
        long max=0;
        while(n>0){
            long r=n%10;
            if(max<r){
                max=r;
            }
            n=n/10;

        }
        System.out.println(max);
    }
}
