import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        long n=s.nextLong();
        long p=1;
        while(n>0){
            long r=n%10;
            p=p*r;
            n=n/10;

        }
        System.out.println(p);
    }
}
