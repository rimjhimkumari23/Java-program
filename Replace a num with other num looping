import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        long a=s.nextLong();
        long b=s.nextLong();
        long c=s.nextLong();
        long rev=0;
        while(a>0){
            long r=a%10;
            rev=rev*10+r;
            a=a/10;
        }
        while(rev>0){
            long p=rev%10;
            if(p==b){
                System.out.print(c);
            }
            else{
                System.out.print(p);
            }
            rev/=10;
        }
    }
}
