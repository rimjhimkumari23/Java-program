import java.util.Scanner;
public class an {
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
       int n=s.nextInt();
        for(int i=1;i<=n;i++){
             char ch='A';
            for(int j=1;j<=i;j++){
                System.out.print(ch++);
            }
            System.out.println();
        }
    }
}
