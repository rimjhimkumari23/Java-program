import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        long c=0,p=0;
        long arr[]=new long[n];
        for(int i=0;i<n;i++){
            arr[i]=s.nextLong();
        }
        for (int i = 0; i < n; i++) {
            if(arr[i]==0){
                c++;
            }
            else{
                p++;
            }
        }
            System.out.print("0:"+c+" "+"1:"+p);
    }
}
