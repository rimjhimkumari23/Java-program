public class an{
    static void rim(int n){
        for(int i=1;i<=n;i++){
            for(int sp=1;sp<=n-i;sp++){
                System.out.print(" ");
            }
            for(int str=1;str<=2*i-1;str++){
                System.out.print("*");
            }
            System.out.println("");
        }
    }
     public static void main(String[] args){
        int a[]={5,6,7,9};
        for(int i=0;i<4;i++){
            System.out.println("testcase: "+a[i]);
            rim(a[i]);
        }
    }
}
