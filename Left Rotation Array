import java.util.Scanner;
public class Main{
    public static void main(String[] args){
    Scanner s=new Scanner(System.in);
    int n=s.nextInt();
    int a[]=new int[n];
    for(int i=0;i<n;i++){
        a[i]=s.nextInt();
    }
    int t=a[0];
    for(int i=0;i<n-1;i++){
        a[i]=a[i+1];
    }
    a[n-1]=t;
    for(int i=0;i<n;i++){
        System.out.print(a[i]+" ");
    }
    }
}
