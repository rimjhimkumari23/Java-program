import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        long arr[]=new long[n];
        for(int i=0;i<n;i++){
            arr[i]=s.nextLong();
        }
        for(int i=0;i<n-1;i++){
            if(arr[i]==arr[i+1]){
                System.out.print(arr[i]+" ");
                while(i<n-1&&arr[i]==arr[i+1]){
                    i++;
                }
            }
        }
    }
}
