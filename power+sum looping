import java.util.Scanner;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        long n=s.nextLong();
        while(n!=1&&n!=4){
        long sum=0;
        while(n>0){
          long r=n%10;
          long p=r*r;
          sum=sum+p;
            n=n/10;
            }
            n=sum;
        }
        if(n==1){
            System.out.println("Yes");
        }
        else{
            System.out.println("No");
        }
    }
}
