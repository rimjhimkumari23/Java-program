import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
		Scanner s=new Scanner(System.in);
		int n=s.nextInt();
		int m=s.nextInt();
		int x=s.nextInt();
		int y=s.nextInt();
		int r=n*x;
		int p=m*y;
		System.out.println(r+p);

	}
}
