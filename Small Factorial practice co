import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
		Scanner s=new Scanner(System.in);
        int t=s.nextInt();
        while(t-->0){
            int n=s.nextInt();
            long f=1;
            for(int i=1;i<=n;i++) {
                f=f*i;
            }
            System.out.println(f);
        }
	}
}
