import java.util.*;
import java.lang.*;
import java.io.*;
class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
        Scanner sc = new Scanner(System.in);
        int T = sc.nextInt();
        while (T-- > 0) {
            int X = sc.nextInt();
            int Y = sc.nextInt();
            int A = sc.nextInt();
            int B = sc.nextInt();
            int ans = 0;
            if (X != A && X != B) {
                ans++;
            }
            if (Y != A && Y != B) {
                ans++;
            }
            System.out.println(ans);
        }
    }
}
